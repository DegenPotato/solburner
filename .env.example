# =============================================================================
# Sol Burner — Environment configuration
# Copy to `.env.local` and fill in. All values are PUBLIC (shipped to client).
# Never put private keys or secrets here.
# =============================================================================

# --- Active brand/theme -------------------------------------------------------
# One of: professional | degen | minimal
VITE_BRAND=degen

# --- RPC endpoints ------------------------------------------------------------
# SECURITY: everything here is inlined into the client bundle at build time.
# NEVER put an RPC URL that contains an api-key here for production — it would be
# publicly extractable from the shipped JS. Instead, point these at a same-origin
# proxy that injects the key server-side (nginx reverse proxy — see DEPLOYMENT.md).
# A relative path like `/rpc` is resolved against the current origin at runtime,
# so it stays domain-agnostic for white-label deployments.
#
#   Production (recommended): VITE_RPC_PRIMARY=/rpc  and  VITE_DAS_ENDPOINT=/rpc
#   Local dev: a direct keyed URL is fine (it never leaves your machine).
VITE_RPC_PRIMARY=https://api.mainnet-beta.solana.com
# Optional comma-separated fallbacks, tried in order on failure.
VITE_RPC_FALLBACKS=
# DAS-capable endpoint (Helius or a proxy to it) — used ONLY for compressed NFTs
# + price hints, which raw RPC cannot do. Point at your `/rpc` proxy in prod.
# Empty + none detected => cNFT tab disabled.
VITE_DAS_ENDPOINT=
# Network: mainnet-beta | devnet | testnet
VITE_SOLANA_NETWORK=mainnet-beta

# --- Fees ---------------------------------------------------------------------
# Service fee as a fraction (0.0087 = 0.87%).
VITE_FEE_RATE=0.0087
# Absolute floor / ceiling for the fee, in SOL.
VITE_FEE_MIN_SOL=0
VITE_FEE_MAX_SOL=0
# Wallet that receives the service fee (base58 pubkey).
VITE_FEE_RECIPIENT=
# Benchmark fee used in the "you save vs X%" comparison (0.02 = 2%). Empty disables.
VITE_BENCHMARK_FEE_RATE=0.02

# --- Referral (optional) ------------------------------------------------------
# Share of the service fee paid to a referrer (0.30 = 30% of the fee).
VITE_REFERRAL_SHARE=0
VITE_REFERRAL_RECIPIENT=

# --- Feature flags ------------------------------------------------------------
VITE_FEATURE_BURN_TOKENS=true
VITE_FEATURE_CLOSE_EMPTY=true
VITE_FEATURE_SIMULATE=true
VITE_FEATURE_SAVINGS_COMPARISON=true
# Asset-type tabs
VITE_FEATURE_NFTS=true
VITE_FEATURE_CNFTS=true
VITE_FEATURE_DOMAINS=true
VITE_FEATURE_LP=true
# Detect + claim pump.fun volume-accumulator rewards (rent + cashback) in Cleanup
VITE_FEATURE_PUMP_REWARDS=true
# Price-based value-protection slider
VITE_FEATURE_VALUE_PROTECTION=true

# --- Pricing ------------------------------------------------------------------
VITE_PRICE_ENABLED=true
# Price resolution order: Helius DAS hint -> Jupiter -> (GMGN if enabled).
# Jupiter's lite API is CORS-open and covers pump.fun / long-tail tokens.
VITE_JUPITER_PRICE_URL=https://lite-api.jup.ag/price/v3
# GMGN is Cloudflare-gated and NOT reachable directly from a browser. Leave off
# unless VITE_GMGN_BASE_URL points at your own same-origin proxy.
VITE_GMGN_ENABLED=false
VITE_GMGN_BASE_URL=https://gmgn.ai/api/v1
VITE_GMGN_CHAIN=sol
